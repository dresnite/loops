{
  "name": "loops",
  "version": "0.1.0",
  "description": "CLI tool for creating reusable AI agent workflows",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "loops": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test:run"
  },
  "keywords": [
    "ai",
    "agents",
    "cli",
    "cursor",
    "workflow",
    "loops"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.10.1",
    "@cursor/sdk": "^1.0.16",
    "citty": "^0.2.2",
    "pathe": "^2.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "execa": "^9.6.1",
    "tsdown": "^0.22.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
